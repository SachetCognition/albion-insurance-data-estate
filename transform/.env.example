# Copy to .env and `source .env` before running `dbt build -t snowflake`.
# The default duckdb target needs NONE of these.
# NEVER commit .env or key files.

export SNOWFLAKE_ACCOUNT=tojgonb-sf03144        # org tojgonb, account sf03144
export SNOWFLAKE_USER=

# Auth option 1 (preferred): key-pair
#export SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
#export SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Auth option 2: password
export SNOWFLAKE_PASSWORD=

export SNOWFLAKE_ROLE=TRANSFORMER
export SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
export SNOWFLAKE_DATABASE=GOLDEN
export SNOWFLAKE_SCHEMA=STAGING
